// The `iu4_gemm` generator with its dense K128 block written out in `.rip`
// from the FINE K-loop natives (cookbook 17): `fine_block` below spells the
// block as head, fragment loads, WMMA groups, publishes, waits, barriers, the
// fold, so wait placement and prefetch order are script choices, each checked
// by the same driver and typed core as the generator.
//
// With `WAIT = "after"` it re-emits the shipped kernel's bytes for every dense
// variant (`tests/iu4_gemm_fine_twin.rs`); `"mid"` and `"before"` re-emit the
// generator's `Tune { wait: Mid | Before }`. The sparse variants keep the
// opaque sparse blocks. To time a variation:
//
//     pm_loop --kernel iu4_gemm ... --rip crates/peacemaker-isa/src/kernels/iu4_gemm_fine.rip
//
// Edit the composition here and re-run: no rebuild.
//
// Variant grammar: the shipped variant name, `Spec::variant_name()`:
//
//     FOLD-TILE-CACC[-slab]-EPI[-s24x64|-s24x32]
//
//     FOLD  k128 | k256s | k256p              (fold granularity; only k128 builds)
//     TILE  128x128x8 | 256x128x16            (rows x tokens x waves)
//     CACC  cacc1 | cacc2                     (int32 accumulator sets; only cacc1 builds)
//     slab  optional: the slab activation layout (default: token layout)
//     EPI   set | add | addsigmoid | silu | silu-bf16 | qkvzagdn
//     MMA   optional: s24x64 | s24x32 = the 2:4-sparse SWMMAC K-loop (set/add on the
//           128x128x8 token-layout tile only; default: the dense WMMA K-loop)
//
// e.g. `k128-128x128x8-cacc1-set`, `k128-128x128x8-cacc1-slab-silu-bf16`,
// `k128-256x128x16-cacc1-add`. A combination without a generator is refused by
// `Iu4Gen::new` with the Rust `Spec::validate` message. `VARIANTS` lists every
// valid one. gfx1201 only.
//
// Blocks work on the typed workgroup scope through `Driver::typed`: `lds` is
// the array of the four LDS rings (A, W, DS, SZ), declared Free, Published/Free
// at a block boundary. A block takes it and returns it.

const ARCHES: &[&str] = &["gfx1201"];

// Where the next slab's publish (the LDS stores into the Free next buffer) sits
// between the WMMA groups: "after" (the shipped order), "mid" (between the two
// 32-K groups) or "before" (ahead of both). The wait and the rotate that make
// it readable stay where they are, so the stores' distance to them grows.
const WAIT: &str = "after";

const VARIANTS: &[&str] = &[
    "k128-128x128x8-cacc1-set",
    "k128-128x128x8-cacc1-slab-set",
    "k128-128x128x8-cacc1-add",
    "k128-128x128x8-cacc1-slab-add",
    "k128-128x128x8-cacc1-addsigmoid",
    "k128-128x128x8-cacc1-silu",
    "k128-128x128x8-cacc1-slab-silu",
    "k128-128x128x8-cacc1-silu-bf16",
    "k128-128x128x8-cacc1-slab-silu-bf16",
    "k128-128x128x8-cacc1-qkvzagdn",
    "k128-128x128x8-cacc1-slab-qkvzagdn",
    "k128-256x128x16-cacc1-set",
    "k128-256x128x16-cacc1-add",
    "k128-256x128x16-cacc1-silu",
    "k128-128x128x8-cacc1-set-s24x64",
    "k128-128x128x8-cacc1-set-s24x32",
    "k128-128x128x8-cacc1-add-s24x64",
    "k128-128x128x8-cacc1-add-s24x32",
];

fn emit(spec: Spec) -> Result<Emitted, String> {
    let g = Iu4Gen::new(iu4_spec(&spec.variant, spec.arch)?)?;
    let mut b = Builder::new(g.kernel_spec(), g.plan()?);
    let mut wg = Workgroup::new(&mut b, spec.arch)?;
    author(&mut wg, &g)?;
    b.finish()
}

// The variant name as the `Iu4Spec` it names.
fn iu4_spec(variant: &str, arch: Arch) -> Result<Iu4Spec, String> {
    let mut parts: Vec<&str> = variant.split('-').collect();
    // An optional trailing `-s24x64` / `-s24x32`: the 2:4-sparse SWMMAC K-loop.
    let mut mma = Mma::Dense;
    let last = parts[parts.len() - 1];
    if last == "s24x64" {
        mma = Mma::S24X64;
        parts.pop();
    } else if last == "s24x32" {
        mma = Mma::S24X32;
        parts.pop();
    }
    if parts.len() < 4 {
        return Err(format!("variant `{variant}`: expected FOLD-TILE-CACC[-slab]-EPI[-s24x64|-s24x32]"));
    }
    let fold = match parts[0] {
        "k128" => Fold::K128,
        "k256s" => Fold::K256Shared,
        "k256p" => Fold::K256Pow2,
        f => return Err(format!("variant `{variant}`: unknown fold `{f}` (k128, k256s, k256p)")),
    };
    let tile = match parts[1] {
        "128x128x8" => Tile::T128x128x8,
        "256x128x16" => Tile::T256x128x16,
        t => return Err(format!("variant `{variant}`: unknown tile `{t}` (128x128x8, 256x128x16)")),
    };
    let cacc = match parts[2] {
        "cacc1" => Cacc::One,
        "cacc2" => Cacc::Two,
        c => return Err(format!("variant `{variant}`: unknown accumulator count `{c}` (cacc1, cacc2)")),
    };
    let slab = parts[3] == "slab";
    let act = if slab { ALayout::Slab } else { ALayout::Token };
    let first = if slab { 4 } else { 3 };
    if first >= parts.len() {
        return Err(format!("variant `{variant}`: missing the epilogue"));
    }
    let name = parts.iter().skip(first).cloned().collect::<Vec<_>>().join("-");
    let epi = match name.as_str() {
        "set" => Epi::Set,
        "add" => Epi::Add,
        "addsigmoid" => Epi::AddSigmoid,
        "silu" => Epi::GateUpSilu,
        "silu-bf16" => Epi::GateUpSiluBf16,
        "qkvzagdn" => Epi::QkvzaGdn,
        e => return Err(format!("variant `{variant}`: unknown epilogue `{e}` (set, add, addsigmoid, silu, silu-bf16, qkvzagdn)")),
    };
    Ok(Iu4Spec { fold: fold, tile: tile, cacc: cacc, epi: epi, act: act, arch: arch, mma: mma })
}

// The Workgroup scope lives here, not in emit(): emit() mentions `b` again at
// finish(), which would end the scope under any later `wg` use.
fn author<T: Target>(wg: &mut Wg<T>, g: &Iu4Gen) -> Result<(), String> {
    let lds = iu4::declare_lds(wg, g)?;
    let end = wg.exit(iu4::END)?;
    // Every symbol runs its K-loop at wave priority 1 and drops to 0 for its
    // epilogue (the fused projection keeps its stores at 1 and drops at the QKV
    // tiles' GDN epilogue), so co-resident K-loops win issue arbitration over a
    // finishing tile. Scheduling only.
    op(wg.isa(), "s_setprio 1", vec![], vec![])?;
    let lds = iu4::prologue(wg, g, end, lds)?;
    let lds = kloop(wg, g, lds)?;
    iu4::epilogue(wg, g, end)?;
    // Only the fused projection reuses the LDS after the K loop: its QKV tiles
    // continue at the GDN label the epilogue's exit branch skips to.
    if g.spec().epi == Epi::QkvzaGdn {
        iu4::gdn_epilogue(wg, g, lds)?;
    }
    wg.end(end)
}

// The rolled K-loop. One trip is a whole 256-K group (two 128-K blocks, plane
// parity 0 then 1), so every LDS address is an immediate and the trip ends in
// the state it started in; `loop_carried` checks that. The last group is
// peeled: its second block fetches and publishes nothing.
fn kloop<T: Target>(wg: &mut Wg<T>, g: &Iu4Gen, lds: Lds) -> Result<Lds, String> {
    wg.label(iu4::K_BEGIN)?;
    // K == 256: no full trip; go straight to the peeled group.
    let no_trip = iu4::trips_cmp(wg, g, "s_cmp_eq_u32")?;
    let lds = wg.wg_skip_if(no_trip, iu4::tail_label(0), lds, |wg, lds| {
        let lds = wg.loop_carried(iu4::K_LOOP, lds, |wg, lds| {
            let lds = mma_block(wg, g, "m0", 0, true, iu4::label("m1"), true, lds)?;
            // The even-block descriptor was last read by block 0's slab-1 fetch;
            // block 1 moves it to block 2g+2 before its own next-block fetch
            // reads it (a step inside the block, after its slab-1 fetch).
            let lds = mma_block_stepping(wg, g, "m1", 1, true, iu4::K_LOOP_END, true, 0, lds)?;
            // Trip end: the odd-block descriptor and the group offset move on
            // after every read of them in this trip.
            iu4::trip_end(wg, g)?;
            let more = iu4::trips_cmp(wg, g, "s_cmp_lg_u32")?;
            Ok((lds, more))
        })?;
        wg.label(iu4::K_LOOP_END)?;
        Ok(lds)
    })?;
    // The skip target is the peeled group's first block label, which this
    // block's `entry_label = false` leaves for the `wg_skip_if` above to place.
    let lds = mma_block(wg, g, "t0", 0, true, iu4::label("t1"), false, lds)?;
    mma_block(wg, g, "t1", 1, false, iu4::EPI, true, lds)
}

// The block of the spec's matrix instruction: the dense WMMA block, spelled out
// below with the fine K-loop natives, or the 2:4-sparse SWMMAC block (opaque:
// the sparse blocks are not split; the weights must be packed by
// `iu4_gemm::sparse24::pack_block`; same arguments, same ring transitions).
fn mma_block<T: Target>(wg: &mut Wg<T>, g: &Iu4Gen, tag: &str, h: usize, fetch_next: bool,
        end_label: &str, entry_label: bool, lds: Lds) -> Result<Lds, String> {
    if g.spec().mma == Mma::Dense {
        fine_block(wg, g, tag, h, fetch_next, end_label, entry_label, None, lds)
    } else {
        iu4::sparse_block(wg, g, tag, h, fetch_next, end_label, entry_label, lds)
    }
}

fn mma_block_stepping<T: Target>(wg: &mut Wg<T>, g: &Iu4Gen, tag: &str, h: usize, fetch_next: bool,
        end_label: &str, entry_label: bool, step: usize, lds: Lds) -> Result<Lds, String> {
    if g.spec().mma == Mma::Dense {
        fine_block(wg, g, tag, h, fetch_next, end_label, entry_label, Some(step), lds)
    } else {
        iu4::sparse_block_stepping(wg, g, tag, h, fetch_next, end_label, entry_label, step, lds)
    }
}

// One K128 block of the dense K-loop on plane `h`, written with the fine
// natives in the order the generator's `block` uses (`WAIT = "after"`; the other
// two placements are the generator's `Tune { wait: Mid | Before }`). `step`
// advances that descriptor right after the block's head, as `block_stepping`.
//
// Ring discipline, each line checked by the driver:
//   publish_*   next buffer Free -> Writing (a Pending token)
//   wait        Pending -> Drained (names the ring set)
//   barrier     rotate: cur retired, the Drained next one published
//   fragments / scale_loads / wmma   read the Published current buffer
fn fine_block<T: Target>(wg: &mut Wg<T>, g: &Iu4Gen, tag: &str, h: usize, fetch_next: bool,
        end_label: &str, entry_label: bool, step: Option<usize>, lds: Lds) -> Result<Lds, String> {
    let lds = iu4::block_begin(wg, g, tag, h, end_label, entry_label, lds)?;
    if let Some(s) = step {
        iu4::step_descriptor(wg, g, s)?;
    }
    // Phase A: slab 0 from slot 0; slab 1 (fetched by the preceding block) is
    // published into slot 1.
    let lds = iu4::fragments(wg, g, lds)?;
    let lds = if WAIT == "after" {
        let lds = iu4::wmma(wg, g, 0, true, false, lds)?;
        let lds = iu4::wmma(wg, g, 1, false, false, lds)?;
        iu4::publish_slab(wg, g, lds)?
    } else if WAIT == "mid" {
        let lds = iu4::wmma(wg, g, 0, true, false, lds)?;
        let lds = iu4::publish_slab(wg, g, lds)?;
        iu4::wmma(wg, g, 1, false, false, lds)?
    } else {
        let lds = iu4::publish_slab(wg, g, lds)?;
        let lds = iu4::wmma(wg, g, 0, true, false, lds)?;
        iu4::wmma(wg, g, 1, false, false, lds)?
    };
    if fetch_next {
        iu4::fetch_next_meta(wg, g, h)?;
    }
    let (da, dw) = iu4::wait(wg, lds, "slab")?;
    wg.barrier((rotate(lds[0], da), rotate(lds[1], dw)))?;
    // Phase B: slab 1 from slot 1, the fold, the next block into slot 0.
    if fetch_next {
        iu4::fetch_next(wg, g, h)?;
    }
    let lds = iu4::fragments(wg, g, lds)?;
    let lds = iu4::d_loads(wg, g, lds)?;
    if !fetch_next {
        // The peeled group's last block: nothing to publish.
        let lds = iu4::wmma(wg, g, 0, false, false, lds)?;
        let lds = iu4::scale_loads(wg, g, tag, lds)?;
        let lds = iu4::wmma(wg, g, 1, false, true, lds)?;
        let lds = iu4::scale_tail(wg, g, tag, lds)?;
        iu4::fold_scale(wg, g)?;
        return Ok(lds);
    }
    let lds = if WAIT == "after" {
        let lds = iu4::wmma(wg, g, 0, false, false, lds)?;
        let lds = iu4::scale_loads(wg, g, tag, lds)?;
        let lds = iu4::wmma(wg, g, 1, false, true, lds)?;
        let lds = iu4::scale_tail(wg, g, tag, lds)?;
        let lds = iu4::publish_slab(wg, g, lds)?;
        iu4::publish_meta(wg, g, lds)?
    } else if WAIT == "mid" {
        let lds = iu4::wmma(wg, g, 0, false, false, lds)?;
        let lds = iu4::scale_loads(wg, g, tag, lds)?;
        let lds = iu4::publish_slab(wg, g, lds)?;
        let lds = iu4::publish_meta(wg, g, lds)?;
        let lds = iu4::wmma(wg, g, 1, false, true, lds)?;
        iu4::scale_tail(wg, g, tag, lds)?
    } else {
        let lds = iu4::publish_slab(wg, g, lds)?;
        let lds = iu4::publish_meta(wg, g, lds)?;
        let lds = iu4::wmma(wg, g, 0, false, false, lds)?;
        let lds = iu4::scale_loads(wg, g, tag, lds)?;
        let lds = iu4::wmma(wg, g, 1, false, true, lds)?;
        iu4::scale_tail(wg, g, tag, lds)?
    };
    let (da, dw, dd, ds) = iu4::wait(wg, lds, "all")?;
    let b2 = wg.signal((rotate(lds[0], da), rotate(lds[1], dw), rotate(lds[2], dd), rotate(lds[3], ds)))?;
    // The signal drained slab-0 stores: the retired payload ring can hold the
    // next K128's slab 1 while this block folds. The odd block runs before the
    // group offset advances, so it names the next group explicitly.
    if h == 0 {
        iu4::fetch_slab1(wg, g, 1)?;
    } else {
        iu4::fetch_slab1_next_group(wg, g)?;
    }
    iu4::fold_scale(wg, g)?;
    wg.wait_arrived(b2)?;
    Ok(lds)
}
